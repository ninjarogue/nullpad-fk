[
  {
    "type": "foo bar"
  },
  {
    "expect": {
      "text": "foo bar",
      "status": "1:8 1L"
    }
  },
  {
    "press": "ArrowLeft",
    "times": 3
  },
  {
    "press": "Enter"
  },
  {
    "expect": {
      "text": "foo \nbar",
      "status": "2:1 2L",
      "under": "b"
    }
  },
  {
    "press": "Tab"
  },
  {
    "expect": {
      "text": "foo \n  bar",
      "status": "2:3 2L"
    }
  },
  {
    "press": "Home"
  },
  {
    "press": "Backspace"
  },
  {
    "expect": {
      "text": "foo   bar",
      "status": "1:5 1L"
    }
  },
  {
    "press": "End"
  },
  {
    "type": "👨‍👩‍👧"
  },
  {
    "press": "Backspace"
  },
  {
    "expect": {
      "text": "foo   bar",
      "status": "1:10 1L"
    }
  },
  {
    "press": "Home"
  },
  {
    "press": "Delete"
  },
  {
    "expect": {
      "text": "oo   bar",
      "status": "1:1 1L",
      "under": "o"
    }
  },
  {
    "press": "End"
  },
  {
    "press": "Enter"
  },
  {
    "type": "next"
  },
  {
    "press": "ArrowUp"
  },
  {
    "press": "End"
  },
  {
    "press": "Delete"
  },
  {
    "expect": {
      "text": "oo   barnext",
      "status": "1:9 1L",
      "under": "n"
    }
  }
]

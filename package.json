{
  "name": "nullpad-fk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/core/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "arch": "depcruise src --config .dependency-cruiser.cjs && pnpm run --silent arch:core-ts-only && pnpm run --silent arch:one-keyboard",
    "arch:core-ts-only": "bad=$(find src/core -type f ! -name '*.ts' ! -name '*.mts' ! -name '*.cts' ! -name tsconfig.json); test -z \"$bad\" || { echo \"src/core holds only .ts, .mts and .cts files. Found:\"; echo \"$bad\"; exit 1; }",
    "arch:one-keyboard": "sh scripts/one-keyboard.sh",
    "test:e2e": "playwright test",
    "test:sweep": "playwright test e2e/sweep.spec.ts",
    "test:typist": "playwright test typist",
    "test:typist:long": "TYPIST_SEQUENCES=3000 playwright test typist",
    "postinstall": "effect-tsgo patch --no-typescript --oxlint",
    "prepare": "test -e .git && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.5",
    "@foldkit/ui": "0.171.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "effect": "4.1.5",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@foldkit/devtools": "0.171.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.8.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}

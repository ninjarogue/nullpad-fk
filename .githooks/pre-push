#!/bin/sh
set -e
cd "$(git rev-parse --show-toplevel)"

step() {
  echo "==> $1"
  shift
  "$@"
}

step format pnpm format:check
step lint pnpm lint
step typecheck pnpm typecheck
step architecture pnpm arch
if sh scripts/vim-oracle-needed.sh; then
  if command -v vim >/dev/null; then
    step vim-oracle pnpm test:oracle
    git diff --quiet e2e/vim-rows/confirmed.txt ||
      echo "pre-push: Vim confirmed new rows; commit e2e/vim-rows/confirmed.txt"
  else
    echo "pre-push: vim is not installed, so the vim oracle is left out"
  fi
fi
step build pnpm build
if [ "${NULLPAD_VIM_TABLES:-}" = 1 ] || sh scripts/vim-tables-needed.sh; then
  step e2e env NULLPAD_GATE_RUN=1 NULLPAD_DIST=dist pnpm test:e2e
else
  echo "pre-push: no vim code changed since origin/main, so the vim tables are left out"
  step e2e env NULLPAD_GATE_RUN=1 NULLPAD_DIST=dist pnpm test:e2e --grep-invert @vim-table
fi
echo "pre-push: all steps passed"

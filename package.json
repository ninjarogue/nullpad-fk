{
  "name": "nullpad-fk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@effect/platform-browser": "4.1.5",
    "@foldkit/ui": "0.171.0",
    "effect": "4.1.5",
    "foldkit": "0.171.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.73.2",
    "@foldkit/devtools": "0.171.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.1",
    "@swc/core": "1.16.22",
    "@tailwindcss/vite": "4.3.5",
    "dependency-cruiser": "18.8.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
